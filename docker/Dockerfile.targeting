# --- Build Stage ---
FROM python:3.11-slim AS builder

WORKDIR /app

# Copy requirements file
COPY services/targeting-service/requirements.txt .

# Install dependencies to a local directory
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --upgrade pip wheel
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt
# OpenTelemetry: auto-instrumentacao (traces e metricas) via opentelemetry-instrument
RUN pip install --no-cache-dir --prefix=/install opentelemetry-distro==0.66b2 opentelemetry-exporter-otlp==1.45.2 opentelemetry-instrumentation-flask==0.66b2 opentelemetry-instrumentation-psycopg2==0.66b2 opentelemetry-instrumentation-requests==0.66b2

# --- Final Stage ---
FROM python:3.11-slim

# Create a non-root user and group
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --upgrade pip wheel
RUN rm -rf /usr/local/lib/python3.11/ensurepip/_bundled

RUN groupadd -r appgroup && useradd -r -g appgroup appuser

WORKDIR /app

# Copy only the installed dependencies from the builder stage
COPY --from=builder /install /usr/local
RUN rm -rf /usr/local/lib/python3.11/site-packages/setuptools* /usr/local/lib/python3.11/site-packages/wheel* /usr/local/lib/python3.11/site-packages/jaraco* /usr/local/lib/python3.11/site-packages/pip*

# Copy the application code
COPY services/targeting-service/ .

# Change ownership
RUN chown -R appuser:appgroup /app

# Switch to the non-root user
USER appuser

# Expose the port
EXPOSE 8003

# Define environment variables
ENV PORT=8003
ENV PYTHONUNBUFFERED=1

# Run the application
ENV OTEL_SERVICE_NAME=targeting-service
ENV OTEL_RESOURCE_ATTRIBUTES=service.namespace=toogle-master,deployment.environment=fiap-fase4
ENV OTEL_TRACES_EXPORTER=otlp
ENV OTEL_METRICS_EXPORTER=otlp
ENV OTEL_LOGS_EXPORTER=none
ENV OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

CMD ["opentelemetry-instrument", "gunicorn", "-b", "0.0.0.0:8003", "app:app"]
